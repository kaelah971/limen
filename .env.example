# Required Telegraph Engine endpoint.
TELEGRAPH_ENGINE_URL=https://your-telegraph-engine.example/v1/ask

# Required EVM signing key. Keep the real value outside source control.
TELEGRAPH_PRIVATE_KEY=

# x402 v2 network expected by the hackathon flow.
TELEGRAPH_EXPECTED_NETWORK=eip155:84532

# Optional per-request timeout in milliseconds.
TELEGRAPH_TIMEOUT_MS=30000

# Optional GitHub token for private repositories and alert endpoints.
GITHUB_TOKEN=

# Optional GitHub API base URL and version.
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10

# Optional GitHub request timeout in milliseconds.
GITHUB_TIMEOUT_MS=30000

# Optional Action-side ledger endpoint. Configure the matching token as a
# repository secret or Action input; never put a backend service-role key here.
LIMEN_LEDGER_URL=http://127.0.0.1:8787
LIMEN_LEDGER_TOKEN=
LIMEN_USAGE_CLASS=production

# Server-only ledger API configuration. These values must not be exposed to
# the Action, browser bundles, public logs, or public repository variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
LIMEN_INGEST_TOKEN=
LIMEN_API_HOST=127.0.0.1
LIMEN_API_PORT=8787

# Optional server-side URL for the public receipt API used by the Next app.
# The browser never receives backend credentials or private ledger access.
LIMEN_PUBLIC_API_URL=http://127.0.0.1:8787

# Optional public site URL used for canonical and social metadata.
LIMEN_SITE_URL=http://localhost:3000
